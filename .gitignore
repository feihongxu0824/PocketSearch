# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/build/
/android/app/debug
/android/app/profile
/android/app/release

# Compiled APK/AAB outputs (the in-tree build/ dir is already ignored,
# but a contributor may drop a pre-built artifact elsewhere).
*.apk
*.aab

# Large model binaries (~162MB combined). Regenerate via
# `scripts/export_onnx.py` + `scripts/convert_mnn.sh`, or download the
# release assets attached to the GitHub release.
assets/models/*.mnn
assets/models/*.onnx

# Demo dataset (~2 GB, 10k Unsplash photos). Regenerate via
# `scripts/download_demo_dataset.py`. See `docs/demo-dataset.md`.
/data/

# iOS CocoaPods
/ios/Pods/
/ios/.symlinks/
/ios/Flutter/Flutter.framework
/ios/Flutter/Flutter.podspec
# Pin only pubspec.lock; the iOS lock file is regenerated by `pod install`.
/ios/Podfile.lock

# iOS scaffolds regenerated by `flutter create --platforms=ios .` and
# `pod install`. Following the zvec-ai/zvec-dart convention: anything
# Xcode/CocoaPods can recreate is kept out of git so contributors set
# their own signing team / bundle id without polluting history.
/ios/Runner.xcodeproj/
/ios/Runner.xcworkspace/
/ios/RunnerTests/

# macOS
.DS_Store
